#:import NoTransition kivy.uix.screenmanager.NoTransition

# Asistente de impresoras (#173, #184). Una decisión y una acción principal
# por paso, con controles grandes y texto sin jerga: lo usan personas sin
# conocimientos técnicos. IP, puerto o driver aparecen solo en "Detalles".
# La lógica está en common/printer_wizard.py; acá solo se dibuja.
#
# Teclado: Tab / Shift+Tab mueven el foco (recuadro azul), Enter o Espacio
# tocan, Escape vuelve atrás.

<AsistenteBoton@BotonFoco>:
    fondo: 0.16, 0.55, 0.3, 1
    font_size: '18sp'
    bold: True
    size_hint_y: None
    height: dp(60)
    background_normal: ''
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: self.fondo if not self.disabled else (0.72, 0.72, 0.75, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
    canvas.after:
        Color:
            rgba: (0.05, 0.15, 0.55, 1) if self.focus else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x - dp(3), self.y - dp(3), self.width + dp(6), self.height + dp(6), dp(12))
            width: dp(2)

<AsistenteSecundario@BotonFoco>:
    font_size: '16sp'
    size_hint_y: None
    height: dp(50)
    background_normal: ''
    background_color: 0.86, 0.88, 0.94, 1
    color: 0.1, 0.2, 0.5, 1
    canvas.after:
        Color:
            rgba: (0.05, 0.15, 0.55, 1) if self.focus else (0, 0, 0, 0)
        Line:
            rectangle: (self.x - dp(2), self.y - dp(2), self.width + dp(4), self.height + dp(4))
            width: dp(2)

<AsistenteTexto@Label>:
    font_size: '18sp'
    color: 0.2, 0.2, 0.25, 1
    halign: 'center'
    valign: 'middle'
    text_size: self.width, None
    size_hint_y: None
    height: self.texture_size[1] + dp(10)

<AsistenteChico@Label>:
    font_size: '14sp'
    color: 0.42, 0.42, 0.48, 1
    halign: 'left'
    valign: 'top'
    text_size: self.width, None
    size_hint_y: None
    height: (self.texture_size[1] + dp(4)) if self.text else 0
    opacity: 1 if self.text else 0

<AsistenteEntrada@TextInput>:
    font_size: '22sp'
    multiline: False
    write_tab: False
    size_hint_y: None
    height: dp(56)
    padding: [dp(12), dp(12)]
    background_color: 1, 1, 1, 1
    foreground_color: 0, 0, 0, 1

<ImpresoraItem>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: [dp(16), dp(12)]
    spacing: dp(3)
    opacity: 1 if (self.seleccionable or self.configurada) else 0.75
    canvas.before:
        Color:
            rgba: (0.84, 0.9, 1, 1) if self.state == 'down' else ((0.92, 0.95, 0.92, 1) if self.configurada else (1, 1, 1, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: (0.05, 0.15, 0.55, 1) if self.focus else (0.78, 0.8, 0.87, 1)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(10))
            width: dp(2.2) if self.focus else dp(1)
    Label:
        text: root.titulo
        font_size: '19sp'
        bold: True
        color: 0.1, 0.16, 0.35, 1
        halign: 'left'
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]
    Label:
        text: root.subtitulo + (("  ·  Ya está configurada como \"" + root.configurada + "\"") if root.configurada else "")
        font_size: '16sp'
        color: 0.3, 0.32, 0.38, 1
        halign: 'left'
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]
    Label:
        text: root.nota
        font_size: '15sp'
        color: 0.62, 0.35, 0.05, 1
        halign: 'left'
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1] if root.nota else 0
        opacity: 1 if root.nota else 0
    Label:
        text: root.oculta_por
        font_size: '14sp'
        italic: True
        color: 0.45, 0.45, 0.5, 1
        halign: 'left'
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1] if root.oculta_por else 0
        opacity: 1 if root.oculta_por else 0
    Label:
        text: root.detalles if root.mostrar_detalles else ""
        font_size: '14sp'
        color: 0.35, 0.35, 0.42, 1
        halign: 'left'
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1] if (root.mostrar_detalles and root.detalles) else 0
        opacity: 1 if root.mostrar_detalles else 0

<PrinterSetupScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [dp(28), dp(22) + app.inset_top, dp(28), dp(22) + app.inset_bottom]
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: 0.96, 0.97, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "Impresoras"
            font_size: '22sp'
            bold: True
            color: 0.1, 0.2, 0.5, 1
            size_hint_y: None
            height: dp(36)

        # Error o aviso del paso actual, con la acción concreta.
        Label:
            text: root.message
            font_size: '17sp'
            color: 0.62, 0.22, 0.1, 1
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None
            size_hint_y: None
            height: (self.texture_size[1] + dp(10)) if root.message else 0
            opacity: 1 if root.message else 0

        # Casos que el asistente no resuelve solo: la guía de doc.paxapos.com.
        AsistenteSecundario:
            id: boton_guia
            text: "Ver la guía paso a paso"
            disabled: not root.guide
            opacity: 1 if root.guide else 0
            height: dp(50) if root.guide else 0
            on_press: root.open_guide()

        # Ante un error o aviso: lo que soporte necesita (#185).
        GridLayout:
            cols: 2
            spacing: dp(10)
            size_hint_y: None
            height: dp(44) if (root.message or root.step == 'problema') else 0
            opacity: 1 if (root.message or root.step == 'problema') else 0
            disabled: not (root.message or root.step == 'problema')
            AsistenteSecundario:
                height: dp(44)
                font_size: '15sp'
                text: root.diagnosis_status or "Copiar diagnóstico para soporte"
                on_press: root.copy_diagnosis()
            AsistenteSecundario:
                height: dp(44)
                font_size: '15sp'
                text: "Ver registro"
                on_press: root.view_log()

        ScreenManager:
            id: pasos
            transition: NoTransition()

            Screen:
                name: 'inicio'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(18)
                    Widget:
                    AsistenteTexto:
                        text: "Vamos a buscar la impresora del local: por cable USB, por la red o instalada en Windows.\nDespués imprimimos un ticket de prueba para confirmar que funciona."
                    AsistenteBoton:
                        id: principal_inicio
                        text: "Buscar impresoras"
                        on_press: root.search()
                    AsistenteSecundario:
                        text: "Sé la dirección de mi impresora de red"
                        on_press: root.choose_address()
                    Widget:

            Screen:
                name: 'resultados'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(10)
                    AsistenteTexto:
                        text: ("Buscando impresoras..." if root.found_count == 0 else "Buscando más impresoras... Ya podés elegir una.") if root.searching else ("Tocá la impresora que querés usar." if root.found_count else "")
                    ScrollView:
                        do_scroll_x: False
                        bar_width: dp(8)
                        BoxLayout:
                            id: lista
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(10)
                            padding: [dp(4), dp(4)]
                    AsistenteChico:
                        text: "\n".join(root.notes)
                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(10)
                        AsistenteSecundario:
                            text: "Dejar de buscar" if root.searching else "Buscar de nuevo"
                            on_press: root.cancel_search() if root.searching else root.search()
                        AsistenteSecundario:
                            text: "Sé la dirección de la impresora"
                            on_press: root.choose_address()
                        AsistenteSecundario:
                            text: "Ocultar detalles" if root.show_details else "Ver detalles"
                            on_press: root.toggle_details()
                        AsistenteSecundario:
                            text: ("Mostrar menos" if root.show_all else "Mostrar todas (" + str(root.hidden_count) + " más)") if root.hidden_count else "Mostrar todas"
                            disabled: not root.hidden_count
                            on_press: root.toggle_show_all()

            Screen:
                name: 'direccion'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(14)
                    Widget:
                    AsistenteTexto:
                        text: "¿Cuál es la dirección de la impresora?"
                    AsistenteEntrada:
                        id: direccion
                        hint_text: "Por ejemplo: 192.168.1.50"
                        input_filter: lambda texto, deshacer: ''.join(c for c in texto if c in '0123456789.')
                        disabled: root.busy
                        on_text_validate: root.submit_address(self.text)
                    Label:
                        text: "Figura en el ticket que imprime la impresora al prenderla con el botón FEED apretado."
                        font_size: '15sp'
                        color: 0.45, 0.45, 0.5, 1
                        halign: 'center'
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1] + dp(6)
                    AsistenteBoton:
                        text: "Buscando la impresora..." if root.busy else "Probar la impresora"
                        disabled: root.busy
                        on_press: root.submit_address(direccion.text)
                    Widget:

            Screen:
                name: 'probando'
                BoxLayout:
                    orientation: 'vertical'
                    Widget:
                    AsistenteTexto:
                        text: "Imprimiendo un ticket de prueba...\nEsto tarda unos segundos."
                    Widget:

            Screen:
                name: 'confirmar'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(14)
                    Widget:
                    AsistenteTexto:
                        text: "Fijate en la impresora: ¿salió un ticket con este código?"
                    Label:
                        text: root.test_code
                        font_size: '46sp'
                        bold: True
                        color: 0.1, 0.2, 0.5, 1
                        size_hint_y: None
                        height: dp(66)
                    AsistenteBoton:
                        text: "Sí, salió"
                        on_press: root.confirm_paper(True)
                    AsistenteBoton:
                        fondo: 0.72, 0.42, 0.1, 1
                        text: "No salió"
                        on_press: root.confirm_paper(False)
                    Widget:

            Screen:
                name: 'problema'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(14)
                    Widget:
                    AsistenteBoton:
                        id: principal_problema
                        text: "Probar de nuevo"
                        disabled: root.busy
                        on_press: root.retry()
                    AsistenteSecundario:
                        text: "Elegir otra impresora"
                        on_press: root.back()
                    Widget:

            Screen:
                name: 'nombre'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(14)
                    Widget:
                    AsistenteTexto:
                        text: "¡Funciona! ¿Cómo querés llamar a esta impresora?"
                    AsistenteEntrada:
                        id: alias
                        text: root.suggested_alias
                        on_text_validate: root.save(self.text)
                    Label:
                        text: "Por ejemplo: Cocina, Barra o Caja."
                        font_size: '15sp'
                        color: 0.45, 0.45, 0.5, 1
                        size_hint_y: None
                        height: dp(24)
                    AsistenteBoton:
                        text: "Guardar"
                        on_press: root.save(alias.text)
                    Widget:

            Screen:
                name: 'guardada'
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(14)
                    Widget:
                    AsistenteTexto:
                        text: "Listo: la impresora quedó configurada.\n" + ("Configuradas ahora: " + ", ".join(root.saved) if root.saved else "")
                    AsistenteBoton:
                        id: principal_guardada
                        text: "Terminar"
                        on_press: root.finish()
                    AsistenteSecundario:
                        text: "Agregar otra impresora"
                        on_press: root.add_another()
                    Widget:

        # Siempre a mano: salir del asistente no detiene el servicio.
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(50)
            spacing: dp(14)

            # Un botón que no aplica al paso se colapsa: no queda un hueco.
            AsistenteSecundario:
                text: "Volver"
                disabled: root.step in ('inicio', 'guardada', 'probando')
                opacity: 0 if self.disabled else 1
                size_hint_x: None if self.disabled else 1
                width: 0
                on_press: root.back()

            AsistenteSecundario:
                text: "Configurar después"
                disabled: root.step == 'guardada'
                opacity: 0 if self.disabled else 1
                size_hint_x: None if self.disabled else 1
                width: 0
                on_press: root.skip()
