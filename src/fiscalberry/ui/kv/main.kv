# NOTA: el ScreenManager y sus pantallas se crean en FiscalberryApp.build()
# (incluyendo AdoptScreen). No declarar acá un root ScreenManager o las
# pantallas se instancian dos veces.

<AdoptScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [dp(20), dp(20) + app.inset_top, dp(20), dp(20) + app.inset_bottom]
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: 0.95, 0.95, 1, 1  # Fondo celeste claro
            Rectangle:
                pos: self.pos
                size: self.size

        # Logo y título
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(120)
            spacing: dp(10)
            
            
            # Logo (string vacío - no se mostrará)
            Image:
                source: app.logo_image
                size_hint_y: None
                height: dp(60)
                fit_mode: 'contain'
                
            Label:
                text: "Vincula tu dispositivo con Paxapos"
                font_size: '18sp'
                bold: True
                color: 0.1, 0.2, 0.5, 1
                size_hint_y: None
                height: dp(40)
                halign: 'center'
        
        # Contenido principal
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(40)
            size_hint_y: None
            height: dp(280)
            
            # Lado izquierdo - Botón
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.5
                spacing: dp(15)
                
                Label:
                    text: "Usar navegador"
                    font_size: '16sp'
                    bold: True
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: 'center'
                
                Button:
                    text: "Abrir vinculación"
                    size_hint_y: None
                    height: dp(60)
                    background_color: 0.2, 0.4, 0.8, 1
                    color: 1, 1, 1, 1
                    font_size: '15sp'
                    on_press: root.open_adoption_link()
                
                Label:
                    text: "Se abrirá la página\nde vinculación"
                    font_size: '12sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: dp(40)
                    halign: 'center'
                    text_size: self.width, None

                # Solo aparece si la vinculación no se pudo preparar. Antes, sin
                # uuid, el botón de arriba se veía normal pero llevaba a un error
                # 500 del servidor, sin ninguna explicación para el usuario.
                Label:
                    text: root.linkError
                    opacity: 1 if root.linkError else 0
                    size_hint_y: None
                    height: self.texture_size[1] if root.linkError else 0
                    font_size: '13sp'
                    color: 0.8, 0.1, 0.1, 1
                    halign: 'center'
                    text_size: self.width, None

                # Los logs solo se podían ver DESPUÉS de vincular, que es justo
                # cuando ya no hacen falta: si la vinculación falla, no había
                # forma de ver por qué desde el dispositivo.
                Button:
                    text: "Ver registro"
                    size_hint_y: None
                    height: dp(40)
                    font_size: '13sp'
                    background_normal: ''
                    background_color: 0.85, 0.85, 0.9, 1
                    color: 0.1, 0.2, 0.5, 1
                    on_press: root.ir_a_logs()

                Widget:
            
            # Lado derecho - QR
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.5
                spacing: dp(15)
                
                Label:
                    text: "Escanear QR"
                    font_size: '16sp'
                    bold: True
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: 'center'
                
                # Contenedor del QR sin fondo
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(180)
                    
                    AsyncImage:
                        source: root.qrCodeLink
                        size_hint: None, None
                        size: dp(160), dp(160)
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        fit_mode: 'contain'
                        
                    # Loading fallback
                    Label:
                        text: "📱 Cargando QR..."
                        font_size: '14sp'
                        color: 0.6, 0.6, 0.6, 1
                        halign: 'center'
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        opacity: 0
                
                Label:
                    text: "Escanea con tu celular"
                    font_size: '12sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: 'center'
                
                Widget:
        
        # Botón de verificación manual
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(70)
            padding: [dp(40), 0]
            spacing: dp(10)
            
            Button:
                text: "Ya completé la vinculación - Verificar"
                size_hint_y: None
                height: dp(50)
                background_color: 0.3, 0.7, 0.3, 1
                color: 1, 1, 1, 1
                font_size: '14sp'
                on_press: root.manual_check_adoption()
            
            # Indicador de monitoreo
            Label:
                text: "Monitoreando vinculación automáticamente..." if root.is_monitoring else ""
                font_size: '11sp'
                size_hint_y: None
                height: dp(20)
                color: 0.5, 0.5, 0.5, 1
                halign: 'center'
        
        # Texto explicativo
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(90)
            spacing: dp(10)
            padding: [dp(20), 0]
            
            Label:
                text: "¿Qué es esto?"
                font_size: '14sp'
                bold: True
                color: 0.2, 0.2, 0.2, 1
                size_hint_y: None
                height: dp(25)
                halign: 'center'
            
            Label:
                text: "Esta vinculación conecta y habilita el servicio de impresión (Paxaprinter)\ncon tu comercio, permitiendo imprimir tickets y facturas automáticamente\ndesde el sistema Paxapos."
                font_size: '12sp'
                color: 0.4, 0.4, 0.4, 1
                size_hint_y: None
                height: dp(55)
                halign: 'center'
                text_size: self.width - dp(40), None
                valign: 'middle'
        
        # Espaciador flexible
        Widget:

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [dp(20), dp(20) + app.inset_top, dp(20), dp(20) + app.inset_bottom]
        spacing: 15
        canvas.before:
            Color:
                rgba: 0.9, 0.9, 1, 1  # Fondo celeste casi blanco
            Rectangle:
                pos: self.pos
                size: self.size

        # Logo eliminado - UI minimalista
        Image:
            source: app.logo_image
            size_hint_y: None
            height: 96
            fit_mode: 'contain'


        Label:
            text: "Iniciar Sesión"
            font_size: 24
            color: 0.1, 0.2, 0.5, 1  # Azul oscuro

        Label:
            text: "Utilice su usuario y contraseña para acceder al sistema."
            size_hint_y: None
            height: 30
            halign: "center"
            valign: "middle"
            text_size: self.size
            color: 0.5, 0.5, 0.5, 1  # Gris tenue

        Label:
            text: root.errorMsg
            color: 0.8, 0.2, 0.2, 1  # Rojo estándar para errores
            font_size: 16
            size_hint_y: None
            height: 30
            halign: "center"
            valign: "middle"
            text_size: self.size

        TextInput:
            id: username
            hint_text: "Usuario"
            multiline: False
            size_hint_y: None
            height: 50
            background_color: 1, 1, 1, 1
            foreground_color: 0, 0, 0, 1
            padding: [10, 10]
            on_text_validate: password.focus = True  # Al presionar Enter, enfocar el siguiente input
        TextInput:
            id: password
            hint_text: "Contraseña"
            password: True
            multiline: False
            size_hint_y: None
            height: 50
            background_color: 1, 1, 1, 1
            foreground_color: 0, 0, 0, 1
            padding: [10, 10]
            on_text_validate: root.login(username.text, password.text)  # Al presionar Enter, ejecutar login
        Button:
            text: "Login"
            size_hint_y: None
            height: 50
            background_color: 0.1, 0.2, 0.5, 1  # Azul oscuro
            color: 1, 1, 1, 1
            on_press: root.login(username.text, password.text)

# Define a reusable Separator widget
<Separator@Widget>:
    canvas:
        Color:
            rgba: 0.8, 0.8, 0.8, 1 # Light gray color for separator
        Rectangle:
            pos: self.x, self.center_y - dp(0.5) # Center the line vertically
            size: self.width, dp(1) # Make it 1dp thick

# ── Indicador circular grande de estado (verde / ámbar / rojo) ──────
<StatusDot@Widget>:
    dot_color: 0.86, 0.25, 0.25, 1
    canvas:
        Color:
            rgba: 1, 1, 1, 0.25
        Ellipse:
            pos: self.center_x - dp(86), self.center_y - dp(86)
            size: dp(172), dp(172)
        Color:
            rgba: self.dot_color
        Ellipse:
            pos: self.center_x - dp(78), self.center_y - dp(78)
            size: dp(156), dp(156)

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [dp(28), dp(28) + app.inset_top, dp(28), dp(28) + app.inset_bottom]
        spacing: dp(14)
        canvas.before:
            Color:
                rgba: 0.96, 0.97, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Header minimalista
        Label:
            text: "Fiscalberry · Servidor de Impresión"
            font_size: '15sp'
            bold: True
            color: 0.1, 0.2, 0.5, 1
            size_hint_y: None
            height: dp(28)
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        # Espaciador superior flexible
        Widget:

        # ── Señal central de estado ──────────────────────────────────
        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            size_hint_y: None
            height: dp(190)

            StatusDot:
                dot_color: (0.16, 0.72, 0.36, 1) if app.status_level == 'ok' else ((0.95, 0.66, 0.15, 1) if app.status_level == 'warn' else (0.86, 0.25, 0.25, 1))

            Label:
                text: "OK" if app.status_level == 'ok' else ("!" if app.status_level == 'warn' else "OFF")
                font_size: '44sp'
                bold: True
                color: 1, 1, 1, 1
                halign: 'center'
                valign: 'middle'

        # Mensaje de estado grande
        Label:
            text: app.status_message
            font_size: '20sp'
            bold: True
            color: (0.12, 0.5, 0.25, 1) if app.status_level == 'ok' else ((0.6, 0.42, 0.05, 1) if app.status_level == 'warn' else (0.6, 0.12, 0.12, 1))
            size_hint_y: None
            height: dp(34)
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None

        # Sub-chips de canales (Socket.IO + RabbitMQ)
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(26)
            spacing: dp(24)
            padding: [dp(30), 0]

            Label:
                markup: True
                text: "[b]Socket.IO[/b]   " + ("conectado" if app.sioConnected else "desconectado")
                font_size: '14sp'
                color: (0.16, 0.55, 0.3, 1) if app.sioConnected else (0.6, 0.2, 0.2, 1)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            Label:
                markup: True
                text: "[b]RabbitMQ[/b]   " + ("conectado" if app.rabbitMqConnected else "desconectado")
                font_size: '14sp'
                color: (0.16, 0.55, 0.3, 1) if app.rabbitMqConnected else (0.6, 0.2, 0.2, 1)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

        # Espaciador inferior flexible
        Widget:

        # Datos del comercio (línea compacta)
        Label:
            text: (app.siteName or 'Sin comercio') + "   ·   " + (app.siteAlias or 'Sin alias') + "   ·   v" + (app.version or '')
            font_size: '13sp'
            color: 0.4, 0.4, 0.45, 1
            size_hint_y: None
            height: dp(24)
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None

        # ── Botonera ──────────────────────────────────────────────────
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(54)
            spacing: dp(14)

            Button:
                text: "Detener servicio" if app.serviceRunning else "Iniciar servicio"
                font_size: '15sp'
                bold: True
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                on_press: root.toggle_service()
                canvas.before:
                    Color:
                        rgba: (0.7, 0.25, 0.2, 1) if app.serviceRunning else (0.16, 0.55, 0.3, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]

            Button:
                text: "Ver Logs"
                font_size: '15sp'
                bold: True
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 1, 1, 1, 1
                on_press: app.root.current = 'logs'
                canvas.before:
                    Color:
                        rgba: 0.1, 0.2, 0.5, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10)]

        # Footer minimalista
        Label:
            text: "ID " + (app.uuid[:8] if app.uuid else 'N/A') + "    ·    " + (app.host or 'Paxapos')
            font_size: '10sp'
            color: 0.55, 0.55, 0.6, 1
            size_hint_y: None
            height: dp(18)
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None

<LogScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: [dp(15), dp(15) + app.inset_top, dp(15), dp(15) + app.inset_bottom]
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 0.96, 0.96, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Header con botón volver y título
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(55)
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0.9
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]
            padding: dp(10)

            Button:
                text: "< Volver"
                size_hint_x: None
                width: dp(90)
                font_size: '13sp'
                bold: True
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 0.1, 0.2, 0.5, 1
                # Vuelve a donde se entró: 'main' no existe como destino válido
                # si el comercio todavía no está vinculado.
                on_press: app.root.current = root.volver_a

            Label:
                text: "Logs en Tiempo Real"
                font_size: '16sp'
                bold: True
                color: 0.1, 0.2, 0.5, 1
                halign: 'center'
                valign: 'middle'

            Button:
                text: "Abrir archivo"
                size_hint_x: None
                width: dp(100)
                font_size: '12sp'
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 0.1, 0.2, 0.8, 1
                on_press: root.open_log_file()

        # Ruta del archivo de log
        Label:
            text: root.logFilePath if root.logFilePath else "Sin archivo de log configurado"
            font_size: '10sp'
            color: 0.5, 0.5, 0.5, 1
            size_hint_y: None
            height: dp(18)
            halign: 'center'
            text_size: self.size

        # Panel de logs con fondo oscuro (terminal style)
        BoxLayout:
            orientation: 'vertical'
            canvas.before:
                Color:
                    rgba: 0.06, 0.06, 0.1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(8)]
            padding: dp(8)

            ScrollView:
                id: scroll_view
                do_scroll_x: False
                scroll_y: 0
                TextInput:
                    id: log_output
                    text: root.logs
                    on_text: scroll_view.scroll_y = 0
                    readonly: True
                    font_size: '13sp'
                    background_color: 0, 0, 0, 0
                    foreground_color: 0.75, 0.95, 0.75, 1
                    size_hint_y: None
                    height: max(self.minimum_height, scroll_view.height)
                    multiline: True
                    cursor_color: 0, 0, 0, 0