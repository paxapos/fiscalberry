ScreenManager:
    LoginScreen:
        name: "login"
    MainScreen:
        name: "main"
    LogScreen: # Add LogScreen here
        name: "logs" # Give it a name for navigation

<AdoptScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: 0.95, 0.95, 1, 1  # Fondo celeste claro
            Rectangle:
                pos: self.pos
                size: self.size

        # Logo y título
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(120)
            spacing: dp(10)
            
            
            # Logo (string vacío - no se mostrará)
            Image:
                source: app.logo_image
                size_hint_y: None
                height: dp(60)
                allow_stretch: True
                keep_ratio: True
                
            Label:
                text: "Vincula tu dispositivo con Paxapos"
                font_size: '18sp'
                bold: True
                color: 0.1, 0.2, 0.5, 1
                size_hint_y: None
                height: dp(40)
                halign: 'center'
        
        # Contenido principal
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(40)
            size_hint_y: None
            height: dp(280)
            
            # Lado izquierdo - Botón
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.5
                spacing: dp(15)
                
                Label:
                    text: "Usar navegador"
                    font_size: '16sp'
                    bold: True
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: 'center'
                
                Button:
                    text: "Abrir vinculación"
                    size_hint_y: None
                    height: dp(60)
                    background_color: 0.2, 0.4, 0.8, 1
                    color: 1, 1, 1, 1
                    font_size: '15sp'
                    on_press: root.open_adoption_link()
                
                Label:
                    text: "Se abrirá la página\nde vinculación"
                    font_size: '12sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: dp(40)
                    halign: 'center'
                    text_size: self.width, None
                
                Widget:
            
            # Lado derecho - QR
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.5
                spacing: dp(15)
                
                Label:
                    text: "Escanear QR"
                    font_size: '16sp'
                    bold: True
                    color: 0.2, 0.2, 0.2, 1
                    size_hint_y: None
                    height: dp(30)
                    halign: 'center'
                
                # Contenedor del QR sin fondo
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(180)
                    
                    AsyncImage:
                        source: root.qrCodeLink
                        size_hint: None, None
                        size: dp(160), dp(160)
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        allow_stretch: True
                        keep_ratio: True
                        
                    # Loading fallback
                    Label:
                        text: "📱 Cargando QR..."
                        font_size: '14sp'
                        color: 0.6, 0.6, 0.6, 1
                        halign: 'center'
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        opacity: 0
                
                Label:
                    text: "Escanea con tu celular"
                    font_size: '12sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: 'center'
                
                Widget:
        
        # Botón de verificación manual
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(70)
            padding: [dp(40), 0]
            spacing: dp(10)
            
            Button:
                text: "Ya completé la vinculación - Verificar"
                size_hint_y: None
                height: dp(50)
                background_color: 0.3, 0.7, 0.3, 1
                color: 1, 1, 1, 1
                font_size: '14sp'
                on_press: root.manual_check_adoption()
            
            # Indicador de monitoreo
            Label:
                text: "🔄 Monitoreando adopción automáticamente..." if root.is_monitoring else ""
                font_size: '11sp'
                size_hint_y: None
                height: dp(20)
                color: 0.5, 0.5, 0.5, 1
                halign: 'center'
        
        # Texto explicativo
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(90)
            spacing: dp(10)
            padding: [dp(20), 0]
            
            Label:
                text: "¿Qué es esto?"
                font_size: '14sp'
                bold: True
                color: 0.2, 0.2, 0.2, 1
                size_hint_y: None
                height: dp(25)
                halign: 'center'
            
            Label:
                text: "Esta vinculación conecta y habilita el servicio de impresión (Paxaprinter)\ncon tu comercio, permitiendo imprimir tickets y facturas automáticamente\ndesde el sistema Paxapos."
                font_size: '12sp'
                color: 0.4, 0.4, 0.4, 1
                size_hint_y: None
                height: dp(55)
                halign: 'center'
                text_size: self.width - dp(40), None
                valign: 'middle'
        
        # Espaciador flexible
        Widget:

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 15
        canvas.before:
            Color:
                rgba: 0.9, 0.9, 1, 1  # Fondo celeste casi blanco
            Rectangle:
                pos: self.pos
                size: self.size

        # Logo eliminado - UI minimalista
        Image:
            source: app.logo_image
            size_hint_y: None
            height: 96
            allow_stretch: True
            keep_ratio: True


        Label:
            text: "Iniciar Sesión"
            font_size: 24
            color: 0.1, 0.2, 0.5, 1  # Azul oscuro

        Label:
            text: "Utilice su usuario y contraseña para acceder al sistema."
            size_hint_y: None
            height: 30
            halign: "center"
            valign: "middle"
            text_size: self.size
            color: 0.5, 0.5, 0.5, 1  # Gris tenue

        Label:
            text: root.errorMsg
            color: 0.8, 0.2, 0.2, 1  # Rojo estándar para errores
            font_size: 16
            size_hint_y: None
            height: 30
            halign: "center"
            valign: "middle"
            text_size: self.size

        TextInput:
            id: username
            hint_text: "Usuario"
            multiline: False
            size_hint_y: None
            height: 50
            background_color: 1, 1, 1, 1
            foreground_color: 0, 0, 0, 1
            padding: [10, 10]
            on_text_validate: password.focus = True  # Al presionar Enter, enfocar el siguiente input
        TextInput:
            id: password
            hint_text: "Contraseña"
            password: True
            multiline: False
            size_hint_y: None
            height: 50
            background_color: 1, 1, 1, 1
            foreground_color: 0, 0, 0, 1
            padding: [10, 10]
            on_text_validate: root.login(username.text, password.text)  # Al presionar Enter, ejecutar login
        Button:
            text: "Login"
            size_hint_y: None
            height: 50
            background_color: 0.1, 0.2, 0.5, 1  # Azul oscuro
            color: 1, 1, 1, 1
            on_press: root.login(username.text, password.text)

# Define a reusable Separator widget
<Separator@Widget>:
    canvas:
        Color:
            rgba: 0.8, 0.8, 0.8, 1 # Light gray color for separator
        Rectangle:
            pos: self.x, self.center_y - dp(0.5) # Center the line vertically
            size: self.width, dp(1) # Make it 1dp thick

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(25)
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: 0.96, 0.96, 1, 1 # Fondo más claro y limpio
            Rectangle:
                pos: self.pos
                size: self.size

        # Header
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(60)
            spacing: dp(15)
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0.8
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]
            padding: dp(15)

            Label:
                text: "Fiscalberry - Servidor de Impresion"
                font_size: '18sp'
                bold: True
                halign: 'left'
                valign: 'middle'
                color: 0.1, 0.2, 0.5, 1
                size_hint_x: 1


        # Panel de información del comercio mejorado
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(100)
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0.9
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]
                Color:
                    rgba: 0.8, 0.8, 0.9, 1
                Line:
                    rounded_rectangle: (self.pos[0], self.pos[1], self.size[0], self.size[1], dp(10))
                    width: 1
            padding: dp(15)

            Label:
                text: "INFORMACIÓN DEL COMERCIO"
                font_size: '14sp'
                bold: True
                color: 0.1, 0.2, 0.5, 1
                size_hint_y: None
                height: dp(20)
                halign: 'center'

            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(20)
                
                Label:
                    text: f"Comercio: {app.siteName or 'No configurado'}"
                    font_size: '13sp'
                    color: 0.3, 0.3, 0.3, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None
                    size_hint_x: 0.6

                Label:
                    text: f"Dispositivo: {app.siteAlias or 'Sin alias'}"
                    font_size: '13sp'
                    color: 0.3, 0.3, 0.3, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None
                    size_hint_x: 0.4

        # ── Panel de estado de conexión ──────────────────────────────────
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(120)
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0.9
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]
                Color:
                    rgba: 0.8, 0.8, 0.9, 1
                Line:
                    rounded_rectangle: (self.pos[0], self.pos[1], self.size[0], self.size[1], dp(10))
                    width: 1
            padding: [dp(15), dp(10)]

            Label:
                text: "ESTADO DE CONEXIÓN"
                font_size: '12sp'
                bold: True
                color: 0.1, 0.2, 0.5, 1
                size_hint_y: None
                height: dp(18)
                halign: 'center'
                text_size: self.size

            # Chips de estado lado a lado
            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(10)
                size_hint_y: None
                height: dp(40)

                # ── Chip Socket.IO ──
                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(6)
                    padding: [dp(10), dp(5)]
                    canvas.before:
                        Color:
                            rgba: (0.85, 1, 0.85, 1) if app.sioConnected else (1, 0.85, 0.85, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8)]
                        Color:
                            rgba: (0.1, 0.6, 0.1, 0.6) if app.sioConnected else (0.7, 0.1, 0.1, 0.6)
                        Line:
                            rounded_rectangle: (self.pos[0], self.pos[1], self.size[0], self.size[1], dp(8))
                            width: 1

                    Label:
                        text: ("Socket.IO\nCONECTADO" if app.sioConnected else "Socket.IO\nDESCONECTADO")
                        font_size: '11sp'
                        bold: True
                        color: (0.05, 0.45, 0.05, 1) if app.sioConnected else (0.55, 0.05, 0.05, 1)
                        halign: 'center'
                        valign: 'middle'
                        text_size: self.size

            # ── Botón Ver Logs ──
            Button:
                text: "Ver Logs en Tiempo Real"
                size_hint_y: None
                height: dp(36)
                font_size: '13sp'
                bold: True
                background_normal: ''
                background_color: 0.1, 0.2, 0.5, 1
                color: 1, 1, 1, 1
                on_press: app.root.current = 'logs'
                canvas.before:
                    Color:
                        rgba: 0.1, 0.2, 0.5, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]

        # Espaciador flexible: absorbe el espacio sobrante
        Widget:

        # Footer
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(25)
            spacing: dp(15)
            canvas.before:
                Color:
                    rgba: 0.9, 0.9, 0.9, 0.7
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(5)]
            padding: dp(10)
            
            Label:
                text: f"ID: {app.uuid[:8] if app.uuid else 'No ID'}"
                font_size: '10sp'
                color: 0.4, 0.4, 0.4, 1
                halign: "left"
                valign: "middle"
                size_hint_x: 0.35
                
            Label:
                text: f"v{app.version if app.version else '1.0'}"
                font_size: '10sp'
                color: 0.4, 0.4, 0.4, 1
                halign: "center"
                valign: "middle"
                size_hint_x: 0.3
                
            Label:
                text: f"{app.host if app.host else 'Paxapos'}"
                font_size: '10sp'
                color: 0.4, 0.4, 0.4, 1
                halign: "right"
                valign: "middle"
                size_hint_x: 0.35
            
<LogScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 0.96, 0.96, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Header con botón volver y título
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(55)
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 0.9
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]
            padding: dp(10)

            Button:
                text: "< Volver"
                size_hint_x: None
                width: dp(90)
                font_size: '13sp'
                bold: True
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 0.1, 0.2, 0.5, 1
                on_press: app.root.current = "main"

            Label:
                text: "Logs en Tiempo Real"
                font_size: '16sp'
                bold: True
                color: 0.1, 0.2, 0.5, 1
                halign: 'center'
                valign: 'middle'

            Button:
                text: "Abrir archivo"
                size_hint_x: None
                width: dp(100)
                font_size: '12sp'
                background_normal: ''
                background_color: 0, 0, 0, 0
                color: 0.1, 0.2, 0.8, 1
                on_press: root.open_log_file()

        # Ruta del archivo de log
        Label:
            text: root.logFilePath if root.logFilePath else "Sin archivo de log configurado"
            font_size: '10sp'
            color: 0.5, 0.5, 0.5, 1
            size_hint_y: None
            height: dp(18)
            halign: 'center'
            text_size: self.size

        # Panel de logs con fondo oscuro (terminal style)
        BoxLayout:
            orientation: 'vertical'
            canvas.before:
                Color:
                    rgba: 0.06, 0.06, 0.1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(8)]
            padding: dp(8)

            ScrollView:
                id: scroll_view
                do_scroll_x: False
                scroll_y: 0
                TextInput:
                    id: log_output
                    text: root.logs
                    on_text: scroll_view.scroll_y = 0
                    readonly: True
                    font_size: '13sp'
                    background_color: 0, 0, 0, 0
                    foreground_color: 0.75, 0.95, 0.75, 1
                    size_hint_y: None
                    height: max(self.minimum_height, scroll_view.height)
                    multiline: True
                    cursor_color: 0, 0, 0, 0